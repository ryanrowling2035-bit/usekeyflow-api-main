              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Contacting\",\n  \"lead_rating\": \"hot\",\n  \"lead_qualification\": \"high_intent_investor\",\n  \"budget\": 2750000,\n  \"actual_price\": 2700000,\n  \"comments\": \"Agent reached out via WhatsApp. Client confirmed appointment for viewing this Saturday.\",\n  \"city\": \"Dubai\",\n  \"community\": \"Dubai Marina\",\n  \"project_name\": \"Marina Gate II\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/leads/{{leadId}}?api_key={{apiKey}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "leads",
                "{{leadId}}"
              ],
              "query": [
                {
                  "key": "api_key",
                  "value": "{{apiKey}}",
                  "description": "Public API Key"
                }
              ]
            },
            "description": "Update lead details, qualification status, rating, budget, comments, or reassign agent."
          },
          "response": []
        },
        {
          "name": "POST Update Lead (IIS / WebDAV Fallback)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-HTTP-Method-Override",
                "value": "PUT",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Contacting\",\n  \"lead_rating\": \"hot\",\n  \"lead_qualification\": \"high_intent_investor\",\n  \"budget\": 2750000,\n  \"actual_price\": 2700000,\n  \"comments\": \"Agent reached out via WhatsApp. Client confirmed appointment for viewing this Saturday.\",\n  \"city\": \"Dubai\",\n  \"community\": \"Dubai Marina\",\n  \"project_name\": \"Marina Gate II\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/leads/{{leadId}}?api_key={{apiKey}}&_method=PUT",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "leads",
                "{{leadId}}"
              ],
              "query": [
                {
                  "key": "api_key",
                  "value": "{{apiKey}}",
                  "description": "Public API Key"
                },
                {
                  "key": "_method",
                  "value": "PUT",
                  "description": "Method spoofing parameter to bypass IIS 405"
                }
              ]
            },
            "description": "Updates lead via POST with _method=PUT and X-HTTP-Method-Override. Use this if the hosting webserver (like IIS WebDAV) blocks HTTP PUT with a 405 error."
          },
          "response": []
        }
      ]
