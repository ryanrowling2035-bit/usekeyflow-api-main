                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number (min: 1)"
                },
                {
                  "key": "limit",
                  "value": "20",
                  "description": "Items per page (1-100, default: 20)"
                },
                {
                  "key": "status",
                  "value": "New Lead",
                  "description": "Filter by status (e.g., 'New Lead', 'Contacting', 'Property Search')",
