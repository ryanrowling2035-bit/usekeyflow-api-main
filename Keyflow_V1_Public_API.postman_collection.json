        {
          "name": "POST Ingest / Create Lead",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+971501234567\",\n  \"name\": \"Ahmed Al Mansoori\",\n  \"email\": \"ahmed.mansoori@example.com\",\n  \"nationality\": \"United Arab Emirates\",\n  \"lead_source\": \"Marketing OS\",\n  \"enquiry_type\": \"buyer\",\n  \"listing_type\": \"sale\",\n  \"lead_rating\": \"hot\",\n  \"lead_qualification\": \"qualified\",\n  \"investment_motivation\": \"Investment / High ROI\",\n  \"budget\": 2500000,\n  \"price_min\": 2000000,\n  \"price_max\": 3000000,\n  \"bedrooms_min\": 2,\n  \"bedrooms_max\": 3,\n  \"bathrooms_min\": 2,\n  \"bathrooms_max\": 3,\n  \"city\": \"Dubai\",\n  \"community\": \"Dubai Marina\",\n  \"project_name\": \"Marina Gate\",\n  \"agent_id\": 5,\n  \"property_reference\": \"DM-R-000001\",\n  \"comments\": \"Interested in high floor 2-bedroom unit with marina view.\",\n  \"marketing_os_lead_id\": \"mos_lead_test_001\",\n  \"utm_source\": \"meta_ads\",\n  \"utm_medium\": \"paid_social\",\n  \"utm_campaign\": \"dubai_marina_q4\",\n  \"utm_term\": \"luxury_apartments\",\n  \"utm_content\": \"video_ad_variant_a\",\n  \"web_url\": \"https://exclusive-links.com/dubai-marina-gate\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/leads?api_key={{apiKey}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "leads"
              ],
              "query": [
                {
                  "key": "api_key",
                  "value": "{{apiKey}}",
                  "description": "Public API Key"
                }
              ]
            },
            "description": "Ingest a new qualified lead into the CRM. Supports automatic contact resolution/deduplication by phone, idempotency check via `marketing_os_lead_id`, UTM tracking, and property linking."
          },
          "response": []
        },
