                {
                  "key": "source",
                  "value": "Marketing OS",
                  "description": "Filter by leadSource or technicalSource",
                  "disabled": true
                },
                {
                  "key": "agent_id",
                  "value": "5",
                  "description": "Filter by assigned agent ID (e.g. 5)",
                  "disabled": true
                },
                {
                  "key": "marketing_os_lead_id",
                  "value": "mos_lead_test_001",
                  "description": "Filter by external Marketing OS Lead ID",
                  "disabled": true
                },
                {
                  "key": "search",
                  "value": "Dubai",
                  "description": "Search referenceNo, phone, comments, contact name/email, agent name/email",
                  "disabled": true
                },
                {
                  "key": "from",
