                  "description": "Created to date (YYYY-MM-DD)",
                  "disabled": true
                },
                {
                  "key": "updated_after",
                  "value": "2026-10-01T00:00:00Z",
                  "description": "Filter leads updated after ISO timestamp",
                  "disabled": true
