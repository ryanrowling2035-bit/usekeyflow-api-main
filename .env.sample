# -------------------------------------------------------
# Application
# -------------------------------------------------------
APP_NAME="UseKey Flow"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# -------------------------------------------------------
# Localization
# -------------------------------------------------------
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# -------------------------------------------------------
# Maintenance Mode
# -------------------------------------------------------
APP_MAINTENANCE_DRIVER=file

# -------------------------------------------------------
# Security
# -------------------------------------------------------
BCRYPT_ROUNDS=12

# -------------------------------------------------------
# Logging
# -------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -------------------------------------------------------
# API Log Authentication
# -------------------------------------------------------
API_LOG_USERNAME=admin
API_LOG_PASSWORD=secret

# -------------------------------------------------------
# Database
# -------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=new_data_pd
DB_USERNAME=root
DB_PASSWORD=

# -------------------------------------------------------
# Session
# -------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# -------------------------------------------------------
# Filesystem & Queue
# -------------------------------------------------------
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# -------------------------------------------------------
# AWS S3 (public + private buckets)
# -------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_PUBLIC_BUCKET=
AWS_PRIVATE_BUCKET=
# Optional CloudFront/CDN domain for the public bucket (leave blank to use the S3 URL)
AWS_PUBLIC_URL=
# Pre-signed URL lifetime for private files, in minutes
S3_SIGNED_URL_TTL=10

# -------------------------------------------------------
# Cache
# -------------------------------------------------------
CACHE_STORE=database
# CACHE_PREFIX=

# -------------------------------------------------------
# Memcached
# -------------------------------------------------------
MEMCACHED_HOST=127.0.0.1

# -------------------------------------------------------
# Redis
# -------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -------------------------------------------------------
# Vite
# -------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# -------------------------------------------------------
# JWT Authentication
# -------------------------------------------------------
JWT_SECRET=
JWT_ALGO=HS256

# -------------------------------------------------------
# Mail Configuration (SMTP)
# -------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# -------------------------------------------------------
# Broadcasting (Pusher/Socket)
# -------------------------------------------------------
BROADCAST_CONNECTION=reverb
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=

# Laravel Reverb (real-time notifications WebSocket server)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

# -------------------------------------------------------
# FFmpeg Configuration
# -------------------------------------------------------
FFMPEG_BINARIES=/usr/bin/ffmpeg
FFPROBE_BINARIES=/usr/bin/ffprobe

# -------------------------------------------------------
# Microsoft Azure OAuth (Outlook Calendar)
# -------------------------------------------------------
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_REDIRECT_URI=

# -------------------------------------------------------
# Property Finder API
# -------------------------------------------------------
PROPERTY_FINDER_API_URL=https://atlas.propertyfinder.com/v1
PROPERTY_FINDER_AUTH_URL=https://atlas.propertyfinder.com/v1/auth/token
PROPERTY_FINDER_API_KEY=
PROPERTY_FINDER_API_SECRET=
# Fallback PF public profile id used when an agent has no user_meta._pfPublicProfileId
PROPERTY_FINDER_DEFAULT_PUBLIC_PROFILE_ID=

# -------------------------------------------------------
# Property Finder Webhooks
# -------------------------------------------------------
PROPERTY_FINDER_WEBHOOK_CALLBACK_URL=https://api.usekeyflow.com/webhooks/property-finder
PROPERTY_FINDER_WEBHOOK_SECRET=
PROPERTY_FINDER_WEBHOOK_EVENTS=listing.published,listing.unpublished,listing.action
CRM_DEFAULT_AGENT_ID=5

# -------------------------------------------------------
# Bayut API
# -------------------------------------------------------
BAYUT_API_URL=https://api.bayut.com/v1
BAYUT_API_TOKEN=

# -------------------------------------------------------
# SalesForce API
# -------------------------------------------------------
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=

# -------------------------------------------------------
# Mobile App Version Enforcement
# Clients send X-App-Platform + X-App-Version + X-App-Build headers.
# iOS is gated on X-App-Version, Android on X-App-Build.
#   *_REQUIRED_VERSION      -> exact match passes through
#   MIN_*_REQUIRED_VERSION  -> exact match passes through with partialUpdate=true
# anything else -> 426 force update. Leave *_REQUIRED_VERSION empty to disable.
# -------------------------------------------------------
IOS_APP_REQUIRED_VERSION=
ANDROID_APP_REQUIRED_VERSION=
MIN_IOS_APP_REQUIRED_VERSION=
MIN_ANDROID_APP_REQUIRED_VERSION=
# Legacy plain-string X-App-Version header (temporary — removing next week).
APP_REQUIRED_APP_VERSION=

# -------------------------------------------------------
# Web Push (VAPID) — self-hosted browser push notifications
# Generate a keypair with: php artisan webpush:vapid-keys
# -------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
